generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  candidate
  employer
  admin
}

enum JobStatus {
  draft
  pending
  live
  paused
  expired
  rejected
}

enum ApplyType {
  external
  internal
}

enum Seniority {
  intern
  junior
  mid
  senior
  lead
  exec
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum TagCategory {
  skill
  chain
  role
  benefit
  region
  seniority
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String     @map("password_hash")
  role          UserRole   @default(candidate)
  displayName   String?    @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  twoFaEnabled  Boolean    @default(false) @map("two_fa_enabled")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  ownedCompanies Company[] @relation("CompanyOwner")
  postedJobs     Job[]     @relation("JobPoster")
  applications   Application[]
  bookmarks      Bookmark[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Tag {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  category    TagCategory
  description String?
  parentId    String?     @map("parent_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  parent      Tag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Tag[] @relation("TagHierarchy")
  jobs        JobTag[]

  @@index([category])
  @@map("tags")
}

model Company {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  website         String?
  logoUrl         String?  @map("logo_url")
  description     String?
  sizeBucket      String?  @map("size_bucket")
  foundedYear     Int?     @map("founded_year")
  hqCountry       String?  @map("hq_country")
  hqCity          String?  @map("hq_city")
  fundingTotalUsd BigInt?  @map("funding_total_usd")
  twitter         String?
  discord         String?
  linkedin        String?
  github          String?
  ownerUserId     String?  @map("owner_user_id")
  isClaimed       Boolean  @default(false) @map("is_claimed")
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner           User?    @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  jobs            Job[]

  @@map("companies")
}

model Job {
  id              String         @id @default(uuid())
  slug            String         @unique
  companyId       String         @map("company_id")
  title           String
  description     String
  location        String?
  countryCode     String?        @map("country_code")
  isRemote        Boolean        @default(false) @map("is_remote")
  seniority       Seniority?
  employmentType  EmploymentType @default(full_time) @map("employment_type")
  salaryMin       Int?           @map("salary_min")
  salaryMax       Int?           @map("salary_max")
  salaryCurrency  String         @default("USD") @map("salary_currency")
  applyType       ApplyType      @default(external) @map("apply_type")
  applyUrl        String?        @map("apply_url")
  applicationEmail String?       @map("application_email")
  postedByUserId  String?        @map("posted_by_user_id")
  source          String         @default("manual")
  status          JobStatus      @default(live)
  isSticky        Boolean        @default(false) @map("is_sticky")
  postedAt        DateTime       @default(now()) @map("posted_at")
  expiresAt       DateTime       @map("expires_at")
  viewsCount      Int            @default(0) @map("views_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poster          User?          @relation("JobPoster", fields: [postedByUserId], references: [id], onDelete: SetNull)
  tags            JobTag[]
  applications    Application[]
  bookmarks       Bookmark[]

  @@index([status, postedAt(sort: Desc)])
  @@index([companyId])
  @@map("jobs")
}

model JobTag {
  jobId   String @map("job_id")
  tagId   String @map("tag_id")
  position Int    @default(0)

  job     Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag     Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
  @@map("job_tags")
}

model Application {
  id              String   @id @default(uuid())
  jobId           String   @map("job_id")
  candidateId     String   @map("candidate_id")
  status          String   @default("submitted")
  coverLetter     String?  @map("cover_letter")
  resumeUrl       String?  @map("resume_url")
  submittedAt     DateTime @default(now()) @map("submitted_at")

  job             Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate       User @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@map("applications")
}

model Bookmark {
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("bookmarks")
}

model Subscription {
  id          String   @id @default(uuid())
  email       String   @unique
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  source      String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("subscriptions")
}

enum ArticleCategory {
  article
  book
  course
  tutorial
  video
  bootcamp
  news
  whitepaper
}

model Article {
  id            String          @id @default(uuid())
  slug          String          @unique
  title         String
  category      ArticleCategory
  author        String
  excerpt       String
  contentMd     String          @map("content_md")
  coverGradient String?         @map("cover_gradient")
  readMinutes   Int?            @map("read_minutes")
  isFree        Boolean         @default(true) @map("is_free")
  externalUrl   String?         @map("external_url")
  publishedAt   DateTime        @map("published_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([category, publishedAt(sort: Desc)])
  @@map("articles")
}
