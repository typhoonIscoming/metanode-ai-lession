# ~/.hermes/.env 模板
# 复制这份到 ~/.hermes/.env 后填入真实 key
# Hermes 默认 0600 权限保护这个文件，不会进 git

# === LLM Providers（按需配，不全用都行） ===

# Anthropic（推荐 OAuth 登录，自动刷新，不用手填 key）
# ANTHROPIC_API_KEY=sk-ant-xxxx

# OpenAI
# OPENAI_API_KEY=sk-xxxx

# OpenRouter（聚合层，一个 key 调 200+ 模型）
# OPENROUTER_API_KEY=sk-or-v1-xxxx

# Google Gemini（OAuth）
# GOOGLE_API_KEY=AIzaxxxx

# Kimi / Moonshot
# KIMI_API_KEY=sk-xxxx

# Hugging Face（自托管 / 开源模型）
# HF_API_KEY=hf_xxxx

# === 消息网关 Token（按需配） ===

# Telegram（从 @BotFather 拿）
# TELEGRAM_BOT_TOKEN=1234567890:AAxxx

# Discord
# DISCORD_BOT_TOKEN=xxx
# DISCORD_GUILD_ID=xxx

# Slack
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_APP_TOKEN=xapp-xxx

# === 其它 ===

# 是否在 CLI 启动时跳过欢迎语
# HERMES_NO_WELCOME=1
