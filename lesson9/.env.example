# Polymarket BTC 套利信号工具 · 仓库根环境变量样例
# cp .env.example .env，填上真值；之后运行期改密钥走 /api/v1/settings PATCH

# ─── 数据库（docker compose 内 backend 会被 docker-compose.yml 覆盖为 db 服务名） ───
DATABASE_URL=postgresql+asyncpg://btc_arb:btc_arb@db:5432/btc_arb

# ─── Web 服务 ─────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# CORS：固定列表 + main.py 另配 regex 通配 3xxx
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Bootstrap 密钥（启动时检测 setting 表对应字段为空就写入；非空跳过不覆盖） ───
# user 在 /settings UI 改过的值不会被 ENV 回灌
BOOTSTRAP_OPENAI_API_KEY=sk-...                                          # OpenAI 兼容端点 key（如 AIHubMix）
BOOTSTRAP_OPENAI_MODEL=gpt-5.5                                            # AIHubMix 推荐 gpt-5.5 / gpt-4o-mini
BOOTSTRAP_OPENAI_BASE_URL=https://aihubmix.com/v1                         # OpenAI 兼容 base URL
BOOTSTRAP_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
BOOTSTRAP_WEB_SEARCH_API_KEY=                                             # v1 未使用，预留 v2
