# Postgres 数据库连接（async driver）
DATABASE_URL=postgresql+asyncpg://btc_arb:btc_arb@db:5432/btc_arb

# Web 服务
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# CORS 允许的源（前端开发与本地访问），逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 仅用于首次 bootstrap：以下值会在 setting 表对应字段为 NULL 时被写入，
# 之后所有运行期改动都走 PATCH /api/v1/settings，env 不再读
BOOTSTRAP_OPENAI_API_KEY=
BOOTSTRAP_WEB_SEARCH_API_KEY=
BOOTSTRAP_FEISHU_WEBHOOK_URL=
